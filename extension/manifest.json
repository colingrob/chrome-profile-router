{
  "manifest_version": 3,
  "name": "Chrome Profile Router",
  "version": "1.0.0",
  "description": "Open this page or a link in the right Chrome profile. Shared choices live in the macOS companion app.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Choose a Chrome profile",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}
